# Instagram Basic Display API — long-lived access token
# See setup instructions in INSTAGRAM_SETUP.md
INSTAGRAM_ACCESS_TOKEN=your_long_lived_token_here

# Formspree — booking form submissions
# Sign up free at formspree.io, create a form, copy the ID from the endpoint URL
# e.g. https://formspree.io/f/xabc1234 → ID is xabc1234
NEXT_PUBLIC_FORMSPREE_ID=your_formspree_form_id_here
